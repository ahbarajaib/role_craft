{
  "manifest_version": 3,
  "name": "RoleCraft — LinkedIn 1-Click Job Copier",
  "version": "1.0.0",
  "description": "Extract LinkedIn job details (title, company, location, clean description, URL) with one click for RoleCraft ATS optimization.",
  "permissions": [
    "clipboardWrite",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
