{
  "manifest_version": 3,
  "name": "RoleCraft — Indeed Job Title Copier",
  "version": "1.0.0",
  "description": "Copy the job title from any Indeed job posting in 1 click for RoleCraft ATS optimization. Elite feature.",
  "permissions": [
    "clipboardWrite",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.indeed.com/viewjob*",
        "https://indeed.com/viewjob*",
        "https://www.indeed.com/jobs/view*",
        "https://indeed.com/jobs/view*",
        "https://www.indeed.com/rc/clk*",
        "https://indeed.com/rc/clk*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
