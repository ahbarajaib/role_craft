{
  "manifest_version": 3,
  "name": "RoleCraft — Indeed 1-Click Job Copier",
  "version": "2.0.0",
  "description": "Copy complete job details from any Indeed job posting in 1 click for RoleCraft ATS optimization. Elite feature.",
  "permissions": [
    "clipboardWrite",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.indeed.com/*",
        "https://indeed.com/*",
        "https://*.indeed.co.in/*",
        "https://indeed.co.in/*",
        "https://*.indeed.co.uk/*",
        "https://indeed.co.uk/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
