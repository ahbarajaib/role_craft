# ──────────────────────────────────────────────
# Application identity
# ──────────────────────────────────────────────
APP_NAME="Resume AI"
APP_VERSION="0.1.0"

# ──────────────────────────────────────────────
# Runtime environment
# Choices: development | staging | production
# ──────────────────────────────────────────────
ENVIRONMENT="development"

# Set to true to enable debug mode (verbose tracebacks, auto-reload).
# Never set to true in production.
DEBUG=false

# ──────────────────────────────────────────────
# Logging
# Choices: DEBUG | INFO | WARNING | ERROR | CRITICAL
# ──────────────────────────────────────────────
LOG_LEVEL="INFO"

# ──────────────────────────────────────────────
# API
# ──────────────────────────────────────────────
API_PREFIX="/api/v1"

# ──────────────────────────────────────────────
# CORS
# Provide as a JSON array of allowed origins.
# ──────────────────────────────────────────────
ALLOWED_ORIGINS='["http://localhost:3000"]'

# ──────────────────────────────────────────────
# Server (used by `python main.py` only)
# ──────────────────────────────────────────────
HOST="0.0.0.0"
PORT=8000

# ──────────────────────────────────────────────
# File uploads
# UPLOAD_DIR: path relative to the backend/ directory
# MAX_UPLOAD_SIZE_BYTES: 5 MB = 5242880
# ──────────────────────────────────────────────
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=5242880

# ──────────────────────────────────────────────
# OpenAI
# Get your key at https://platform.openai.com/api-keys
# Never commit the real key – add it only to your local .env file.
# OPENAI_MODEL: gpt-4o-mini (cheap, supports structured outputs)
#               gpt-4o      (higher quality, higher cost)
# ──────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
