# ──────────────────────────────────────────────
# Application identity
# ──────────────────────────────────────────────
APP_NAME="Resume AI"
APP_VERSION="0.1.0"

# ──────────────────────────────────────────────
# Runtime environment
# Choices: development | staging | production
# ──────────────────────────────────────────────
ENVIRONMENT="development"

# Set to true to enable debug mode (verbose tracebacks, auto-reload).
# Never set to true in production.
DEBUG=false

# ──────────────────────────────────────────────
# Logging
# Choices: DEBUG | INFO | WARNING | ERROR | CRITICAL
# ──────────────────────────────────────────────
LOG_LEVEL="INFO"

# ──────────────────────────────────────────────
# API
# ──────────────────────────────────────────────
API_PREFIX="/api/v1"

# ──────────────────────────────────────────────
# CORS
# Provide as a JSON array of allowed origins.
# ──────────────────────────────────────────────
ALLOWED_ORIGINS='["http://localhost:3000"]'

# ──────────────────────────────────────────────
# Server (used by `python main.py` only)
# ──────────────────────────────────────────────
HOST="0.0.0.0"
PORT=8000
