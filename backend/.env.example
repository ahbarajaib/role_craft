# ──────────────────────────────────────────────
# Application identity
# ──────────────────────────────────────────────
APP_NAME="RoleCraft"
APP_VERSION="0.1.0"

# ──────────────────────────────────────────────
# Runtime environment
# Choices: development | staging | production
# ──────────────────────────────────────────────
ENVIRONMENT="development"

# Set to true to enable debug mode (verbose tracebacks, auto-reload).
# Never set to true in production.
DEBUG=true

# ──────────────────────────────────────────────
# Logging
# Choices: DEBUG | INFO | WARNING | ERROR | CRITICAL
# ──────────────────────────────────────────────
LOG_LEVEL="INFO"

# ──────────────────────────────────────────────
# API & Routing
# ──────────────────────────────────────────────
API_PREFIX="/api/v1"

# ──────────────────────────────────────────────
# CORS
# Provide as a JSON array of allowed origins.
# ──────────────────────────────────────────────
ALLOWED_ORIGINS='["http://localhost:3000","https://rolecraft.tech","https://admin.rolecraft.tech"]'

# ──────────────────────────────────────────────
# Server (used by `python main.py` only)
# ──────────────────────────────────────────────
HOST="0.0.0.0"
PORT=8000

# ──────────────────────────────────────────────
# File uploads
# UPLOAD_DIR: path relative to the backend/ directory
# MAX_UPLOAD_SIZE_BYTES: 5 MB = 5242880
# ──────────────────────────────────────────────
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=5242880
GENERATED_CLEANUP_HOURS=24

# ──────────────────────────────────────────────
# OpenAI API
# Get your key at https://platform.openai.com/api-keys
# ──────────────────────────────────────────────
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TIMEOUT_SECONDS=120.0

# ──────────────────────────────────────────────
# Google Authentication (OAuth)
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID="1096884021839-...apps.googleusercontent.com"

# ──────────────────────────────────────────────
# JWT User Sessions
# ──────────────────────────────────────────────
JWT_SECRET="supersecretrolecraftkey"
JWT_ALGORITHM="HS256"
JWT_EXPIRY_MINUTES=10080

# ──────────────────────────────────────────────
# Razorpay Payments & Subscriptions
# ──────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_PLAN_PRO_ID="plan_..."
RAZORPAY_PLAN_ELITE_ID="plan_..."
RAZORPAY_WEBHOOK_SECRET=""

# ──────────────────────────────────────────────
# Credit Allocation System
# ──────────────────────────────────────────────
FREE_TIER_CREDITS=15
VIP_CREDITS=300
PRO_CREDITS=200
ELITE_CREDITS=400
VIP_EMAILS='["ahbarajaib@gmail.com","absarajaib@gmail.com"]'

# ──────────────────────────────────────────────
# Email / SMTP Configuration (Issue Reporter)
# ──────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER="ahbarajaib@gmail.com"
SMTP_PASSWORD="[gmail-app-password]"
SMTP_FROM_EMAIL="noreply@rolecraft.tech"
SUPPORT_NOTIFICATION_EMAIL="ahbarajaib@gmail.com"

# ──────────────────────────────────────────────
# Admin Dashboard (admin.rolecraft.tech / /xrc-control/)
# ──────────────────────────────────────────────
ADMIN_SECRET="your-admin-secret-pin"

# ──────────────────────────────────────────────
# Sentry Crash & Error Monitoring
# ──────────────────────────────────────────────
SENTRY_DSN="https://51d5994f24162ec32cf028bd2eec3f72@o4510357324890112.ingest.de.sentry.io/4512043959517264"
